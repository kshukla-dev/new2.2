# ============================================================
# Environment variables for next-app (Jackson & Frank site)
# Copy this file to .env.local and fill in values as needed.
#
# Every variable is OPTIONAL for local dev (the code has fallbacks),
# but GOOGLE_VERIFICATION_ID should be set in production, and
# NEXT_PUBLIC_API_BASE_URL should point at the live API in prod.
#
# NOTE: Sanity projectId/dataset are hardcoded (public) in src/lib/sanity.ts.
# The site works with no token (public + CDN). Set SANITY_API_TOKEN below to
# authenticate reads and bypass the CDN so newly published blogs appear
# immediately.
# ============================================================

# Sanity read token (server-only — NO NEXT_PUBLIC_ prefix, never sent to the
# browser). Optional. When set, src/lib/sanity.ts authenticates requests and
# disables the CDN so newly published blog posts show up right away.
# Create one in Sanity: Manage > API > Tokens, with Viewer (read) permission.
SANITY_API_TOKEN=

# Base URL for the backend API (contact form, blog, newsletter).
# Referenced in: src/lib/contact.ts, src/services/contact.ts,
#                src/lib/blog.ts, src/services/blog.ts, app/contact/page.tsx
# Defaults to "/api/v1" (relative), which next.config.ts rewrites to
# https://jacksonandfrank.com/api/:path*. Set an absolute URL to bypass the rewrite.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Public site URL — used for canonical URLs and SEO metadata.
# Referenced in: src/lib/constants.ts
# Falls back to https://jacksonandfrank.com when unset.
NEXT_PUBLIC_SITE_URL=https://jacksonandfrank.com

# Calendly booking link used by "Book a call" CTAs.
# Referenced in: src/lib/constants.ts (has a hardcoded fallback).
NEXT_PUBLIC_CALENDLY_URL=

# Google Search Console site-verification token.
# Referenced in: app/layout.tsx (metadata.verification.google)
GOOGLE_VERIFICATION_ID=

# Secret that authorizes the IndexNow submission route (app/indexnow/route.ts).
# Requests can also use the hardcoded IndexNow key via ?key=. Optional.
INDEXNOW_SECRET=
